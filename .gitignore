# =============================================================================
# Reproducibility artifacts (committed so main-text Figure 1 and Tables 1-3
# reproduce from a fresh clone). Model weights (*.pt/*.safetensors/*.bin) stay
# ignored above; only data/result artifacts are un-ignored here.
# =============================================================================

# Workflow figure shown in the README (generated by make_workflow_fig.py)
!/workflow.png
!/workflow.pdf

# Ground truth + root simulation seed/reference data (root-anchored so these
# do not accidentally un-ignore appendix truth files elsewhere in the tree)
!/truth.json
!/data_truth.csv

# Synthetic covariate / hybrid data used by main-text results
!llm_data/syn_clean.csv
!gan_data/syn_clean.csv

# Figure 1 (privacy)
!privacy/results/*.json
!privacy/plot/*.png

# Table 1 (positivity)
!positivity/data/**
!positivity/augmented_qhyb_pair/**
!positivity/augmented_qhyb_flip/**
!positivity/augmented_self_supervised/**
!positivity/results/*.json
!positivity/results/*.csv

# Table 2 (simulator diagnostic engine)
!simulator/real_data_n1000_rct/**
!simulator/results/*.json
!simulator/results/*.csv

# Table 3 (ACTG175 — publicly available trial dataset)
!actg175/actg175.csv
!actg175/data/*.csv
!actg175/llm_data/*.csv
!actg175/ctgan_data/*.csv
!actg175/results/*.json
!actg175/plot/*.png

# Claude Code local settings (not part of the project)
.claude/

# Local-only files (kept private, not pushed to remote)
/reproducibility_checklist.tex
/make_workflow_fig.py
